      ],
      "formulas": [
        {
          "cell": "J2",
          "formula": "=IF(G2=\"\",TODAY()-C2,G2-C2)"
        },
        {
          "cell": "K2",
          "formula": "=E2-I2"
        },
        {
          "cell": "E7",
          "formula": "=SUM(E2:E6)"
        },
        {
          "cell": "I7",
          "formula": "=SUM(I2:I6)"
        }
      ],
      "notes": "J2 counts days from discovery to filing, or to today if not yet filed. K2 shows estimate minus recovered. E7 and I7 total estimates and recoveries. Move Status through Open, Estimate Obtained, Filed or Billed, Awaiting Response, Disputed, Resolved Paid, Resolved Partial, Closed Unrecovered. Sample rows are illustrative."
    }
  ]
}