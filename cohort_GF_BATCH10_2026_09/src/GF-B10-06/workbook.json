{"sheets": [{"columns": ["Request ref (illustrative)", "Date received", "Request type (access/deletion)", "Requester contact", "Identity verified (yes/no)", "Scope agreed date", "Statutory deadline (computed)", "Internal SLA date (computed)", "Stage", "Days remaining (computed)", "Status"], "example_rows": [["DSAR-ILL-01", "2026-03-02", "access", "requester email on file", "yes", "2026-03-05", "2026-04-01", "2026-03-25", "Scoped", 5, "Open"], ["DSAR-ILL-02", "2026-03-04", "deletion", "requester email on file", "no", "", "2026-04-03", "2026-03-27", "Received", 8, "Awaiting identity"]], "formulas": [{"cell": "G2", "formula": "=WORKDAY(B2,30)"}, {"cell": "H2", "formula": "=WORKDAY(B2,23)"}, {"cell": "J2", "formula": "=NETWORKDAYS(TODAY(),G2)"}, {"cell": "G3", "formula": "=WORKDAY(B3,30)"}, {"cell": "H3", "formula": "=WORKDAY(B3,23)"}, {"cell": "J3", "formula": "=NETWORKDAYS(TODAY(),G3)"}], "name": "request_log", "notes": "Statutory deadline uses 30 business-day computation as a working proxy; verify obligations with qualified counsel since the brief cites 30 days GDPR and 45 days several US states. Internal SLA uses 23 business days. All refs and dates are illustrative."}, {"columns": ["Request ref (illustrative)", "Check item", "Evidence seen", "Verified by", "Date", "Result"], "example_rows": [["DSAR-ILL-01", "Illustrative: government ID matched to account name", "ID reference noted, not stored", "Support lead", "2026-03-03", "Pass"], ["DSAR-ILL-01", "Illustrative: account email ownership confirmed", "Verification link confirmed", "Support lead", "2026-03-03", "Pass"]], "formulas": [], "name": "verification_checklist", "notes": "Do not advance to Scoped until identity checks pass. Minimize copies of identity documents."}, {"columns": ["Source name (illustrative)", "Owner", "Data categories held", "Retention basis", "Deletion method", "Last reviewed"], "example_rows": [["ILL-DB-main", "Engineering", "Illustrative: account profile fields", "Contract performance", "Soft delete then purge per runbook", "2026-02-20"], ["ILL-support-desk", "Support", "Illustrative: ticket history", "Legitimate interest per counsel advice", "Ticket anonymization", "2026-02-20"]], "formulas": [], "name": "source_registry", "notes": "One row per system that may hold requester data. Review when systems change."}, {"columns": ["Request ref (illustrative)", "Source", "Action required", "Assigned to", "Due date (illustrative)", "Evidence of completion", "Done"], "example_rows": [["DSAR-ILL-02", "ILL-DB-main", "Illustrative: delete profile row", "Engineer on duty", "2026-03-20", "Ticket number noted", "No"], ["DSAR-ILL-02", "ILL-backups", "Illustrative: confirm expiry on rotation", "Engineer on duty", "2026-03-22", "Backup log noted", "No"]], "formulas": [], "name": "deletion_runbook_tracker", "notes": "Track per-source deletion steps. Backups and logs need special handling per runbook."}, {"columns": ["Metric (computed)", "Value", "Notes"], "example_rows": [["Open requests", 2, "Count of rows with Status Open"], ["Due within 5 business days (illustrative threshold)", 1, "Uses Days remaining column"], ["Overdue (past statutory deadline proxy)", 0, "Requires immediate review with counsel"]], "formulas": [{"cell": "B2", "formula": "=COUNTIF(request_log!K2:K100,\"Open\")"}, {"cell": "B3", "formula": "=COUNTIFS(request_log!K2:K100,\"Open\",request_log!J2:J100,\"<=5\")"}, {"cell": "B4", "formula": "=COUNTIFS(request_log!K2:K100,\"Open\",request_log!J2:J100,\"<0\")"}], "name": "sla_dashboard", "notes": "Dashboard counts read from request_log. Thresholds are illustrative working aids, not legal determinations."}], "workbook_filename": "dsar_response_kit_workbook.xlsx"}
