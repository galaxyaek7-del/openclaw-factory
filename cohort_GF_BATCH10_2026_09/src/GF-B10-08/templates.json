                "Refund or exchange method:",
                "Appeal path and deadline:"
              ]
            }
          ]
        },
        {
          "heading": "Limits and review",
          "body": [
            "Describe narrow time-bound limits, review dates, and release criteria without accusatory language.",
            {
              "fields": [
                "Restricted actions and scope:",
                "Duration and review date:",
                "Release criteria:",
                "Reviewer role:"
              ]
            }
          ]
        }
      ]
    },
    {
      "filename_docx": "denial_with_reason_letter.docx",
