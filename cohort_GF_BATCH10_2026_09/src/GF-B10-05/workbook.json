]], "formulas": [{"cell": "I2", "formula": "=IF(H2<>\"\",E2,0)"}, {"cell": "I3", "formula": "=IF(H3<>\"\",E3,0)"}, {"cell": "I4", "formula": "=SUM(I2:I50)"}], "name": "change_order_log", "notes": "Billed amount counts only when Date approved is filled. Total row at I4 sums billed amounts. All refs and amounts are illustrative."}, {"columns": ["Deliverable (D-number)", "Rounds included (illustrative)", "Round 1 date", "Round 2 date (illustrative)", "Extra rounds used", "Overage rate per round (illustrative)", "Extra billed"], "example_rows": [["D1", 2, "2026-02-12", "2026-02-14", 0, 60, 0], ["D2", 2, "2026-02-15", "", 1, 60, 60]], "formulas": [{"cell": "G2", "formula": "=E2*F2"}, {"cell": "G3", "formula": "=E3*F3"}, {"cell": "G4", "formula": "=SUM(G2:G50)"}], "name": "revision_counter", "notes": "One row per deliverable. Extra billed equals extra rounds times overage rate. All counts and rates are illustrative."}, {"columns": ["Service code", "Service description", "Unit", "Rate (illustrative)", "Notes"], "example_rows": [["standard", "Illustrative: general design revision work", "per hour", 60, "Used by scope register lookup"], ["rush", "Illustrative: expedited delivery", "per hour", 90, "Applies only when rush agreed in writing"]], "formulas": [], "name": "rate_card", "notes": "Fill with real rates before use. Example rates are illustrative and must be replaced."}], "workbook_filename": "freelancer_scope_control_workbook.xlsx"}
