{
  "workbook_filename": "sales_tax_nexus_tracker_workbook.xlsx",
  "sheets": [
    {
      "name": "State Threshold Register",
      "columns": [
        "State",
        "Rolling-12mo sales (from log)",
        "Threshold description (per state source)",
        "Measurement period (per state source)",
        "Last verified date",
        "Verification source (state revenue dept + CPA)",
        "Next re-verify date",
        "Days since verified",
        "Status (verified/pending/stale)"
      ],
      "example_rows": [
        [
          "Example State A (illustrative)",
          84200,
          "Verify current threshold with the state revenue department (illustrative placeholder, not a fact).",
          "Verify window with state source (illustrative).",
          "2026-09-01",
          "State revenue dept guidance + CPA confirmation Sep 2026 (illustrative).",
          "2026-12-01",
          9,
          "verified"
        ],
        [
          "Example State B (illustrative)",
          12100,
          "Pending verification - do not rely.",
          "",
          "",
          "",
          "2026-10-01",
          "",
          "pending"
        ]
      ],
      "formulas": [
        {
          "cell": "H3",
          "formula": "=IF(E2=\"\",\"\",TODAY()-E2)"
        },
        {
          "cell": "H4",
          "formula": "=IF(E3=\"\",\"\",TODAY()-E3)"
        },
        {
          "cell": "I3",
          "formula": "=IF(E2=\"\",\"pending\",IF(H3>90,\"stale\",\"verified\"))"
        },
        {
          "cell": "B5",
          "formula": "=SUM(B2:B3)"
        }
      ],
      "notes": "Index of verification work only. States no threshold as current fact. Background only: many states use $100,000 sales as one part of their test, rules vary, several states dropped transaction tests 2024-2026. Verify current threshold with the state revenue department every cycle. Example rows illustrative."
    },
    {
      "name": "Monthly Sales by State",
      "columns": [
        "Month",
        "Export date filed",
        "State A owned (illustrative)",
        "State A marketplace (illustrative)",
        "State B owned (illustrative)",
        "State B marketplace (illustrative)",
        "State A rolling 12mo",
        "State B rolling 12mo",
        "Notes"
      ],
      "example_rows": [
        [
          "2026-07",
          "2026-08-02",
          7000,
          2000,
          900,
          400,
          84000,
          11800,
          "Illustrative figures only."
        ],
        [
          "2026-08",
          "2026-09-02",
          7200,
          2100,
          950,
          350,
          84200,
          12100,
          "Illustrative figures only."
