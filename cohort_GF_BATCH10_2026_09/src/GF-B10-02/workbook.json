        [
          "Example State A (illustrative)",
          "2026-Q4",
          "Quarterly (illustrative).",
          "2027-01-20",
          "Bookkeeper",
          "Ops Manager",
          "not yet due",
          85,
          "",
          "Illustrative: preparation scheduled."
        ]
      ],
      "formulas": [
        {
          "cell": "H4",
          "formula": "=IF(D2=\"\",\"\",D2-TODAY())"
        },
        {
          "cell": "H5",
          "formula": "=IF(D3=\"\",\"\",D3-TODAY())"
        },
        {
          "cell": "H6",
          "formula": "=COUNTIF(G2:G100,\"filed\")+COUNTIF(G2:G100,\"confirmed\")"
        },
        {
          "cell": "H7",
          "formula": "=COUNTIF(G2:G100,\"not yet due\")+COUNTIF(G2:G100,\"prepared\")"
        }
      ],
      "notes": "One row per registration per period. Enter due dates as verified per period. File confirmations the week they arrive. Example rows illustrative."
    }
  ]
