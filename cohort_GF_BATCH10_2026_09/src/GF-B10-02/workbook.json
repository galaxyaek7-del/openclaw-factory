          "2026-10-02",
          6800,
          1900,
          1000,
          300,
          83900,
          12300,
          "Illustrative figures only."
        ]
      ],
      "formulas": [
        {
          "cell": "G5",
          "formula": "=SUM(C2:C4)+SUM(D2:D4)"
        },
        {
          "cell": "H5",
          "formula": "=SUM(E2:E4)+SUM(F2:F4)"
        },
        {
          "cell": "G6",
          "formula": "=SUM(C2:C100)+SUM(D2:D100)"
        },
        {
          "cell": "H6",
          "formula": "=SUM(E2:E100)+SUM(F2:F100)"
        },
        {
          "cell": "C6",
          "formula": "=COUNT(C2:C100)"
        }
      ],
      "notes": "One row per closed month. Never overwrite closed months; post adjustments in the current month with a reference note. Rolling totals are monitoring signals, not tax determinations. Confirm channel mapping per state with CPA. Example rows illustrative."
    },
    {
      "name": "Registration Checklist",
      "columns": [
        "State",
        "CPA confirmed (Y/N + date)",
        "Portal / form (per state source)",
        "Application submitted date",
        "Account ref stored securely (Y/N + date)",
        "Frequency assigned (per state)",
        "Calendar rows created (Y/N)",
        "Overall status (open/complete)",
        "Owner",
        "Note"
      ],
      "example_rows": [
        [
          "Example State A (illustrative)",
          "Y 2026-09-05",
          "State portal per current instructions (illustrative).",
          "2026-09-12",
          "Y 2026-09-16",
          "Quarterly per state notice (illustrative).",
          "Y",
          "complete",
          "Ops Manager",
          "Illustrative: confirmation filed."
        ],
        [
          "Example State B (illustrative)",
          "N",
          "",
          "",
          "N",
          "",
          "N",
          "open",
          "Ops Manager",
          "Illustrative: awaiting CPA confirmation."
        ]
      ],
      "formulas": [
        {
          "cell": "H5",
          "formula": "=COUNTIF(H2:H100,\"open\")"
        },
        {
          "cell": "H6",
          "formula": "=COUNTIF(H2:H100,\"complete\")"
        },
        {
          "cell": "G5",
          "formula": "=COUNTIFS(H2:H100,\"complete\",G2:G100,\"N\")"
        }
      ],
      "notes": "Close a row only with CPA note, submission record, secure account reference, assigned frequency, and created calendar rows. Example rows illustrative."
    },
    {
      "name": "Filing Calendar",
      "columns": [
        "State",
        "Period label",
        "Frequency",
        "Due date (verified)",
        "Preparer",
        "Reviewer",
        "Status (not yet due/prepared/filed/paid/confirmed)",
        "Days until due",
        "Confirmation ref",
        "Note"
      ],
      "example_rows": [
        [
          "Example State A (illustrative)",
          "2026-Q3",
          "Quarterly (illustrative).",
          "2026-10-20",
          "Bookkeeper",
          "Ops Manager",
          "filed",
          -5,
