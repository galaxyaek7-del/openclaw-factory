{
  "_comment": "Galaxy Forge quality toolchain registry/config. Each tool must earn its place through benchmark evidence. No tool listed here is force-integrated; each entry carries availability/classification/licensing and an explicit disabled flag so any tool can be switched off safely without touching production engine code.",
  "version": "1.0.0",
  "thresholds": {
    "_note": "Benchmark-calibrated 2026-09-02 on the controlled Arabic corpus + real-product validation (2026-09-02). textstat/OSMAN at min_osman=55 yields precision 1.0 / recall 1.0 on the controlled corpus; OSMAN is NOT_APPLICABLE (never fabricated) on non-Arabic text. contamination_ratio (max_contamination <= 0.5) is the PRIMARY distinctiveness signal for long-text reuse per the real-product benchmark; Jaccard (max_overlap <= 0.5) is SECONDARY/comparative. ALL thresholds are CALIBRATED FOR THE AVAILABLE BENCHMARK, NOT UNIVERSAL QUALITY THRESHOLDS.",
    "arabic_readability_osman": {"min_osman_score": 55.0, "_evidence": "benchmark F1 1.0 @thr=55 (controlled Arabic corpus)"},
    "distinctiveness_overlap": {"max_overlap": 0.5, "max_lcs_ratio": 0.25, "max_contamination": 0.5, "_evidence": "real-product benchmark 2026-09-02; contamination PRIMARY for long-text reuse; FP calibrated range recorded in REAL_PRODUCT_QUALITY_BENCHMARK_REPORT.md"}
  },
  "product_types": {
    "arabic_book": {
      "stack": ["content_qa", "language_qa", "originality_qa", "structural_qa", "visual_qa", "commercial_qa"],
      "distinctiveness": {"normalize": true, "product_normalization": "factory_standard_boilerplate_discount"}
    },
    "english_book": {
      "stack": ["content_qa", "originality_qa", "structural_qa", "visual_qa", "commercial_qa"]
    },
    "printable_template": {
      "stack": ["structural_qa", "visual_qa", "content_qa", "export_qa"]
    },
    "game": {
      "stack": ["functional_qa", "performance_qa", "visual_flow_qa", "ux_human_playtest"]
    },
    "b2b_software": {
      "stack": ["functional_qa", "security_qa", "data_integrity_qa", "ux_qa", "evidence_validation"]
    },
    "_fallback": {
      "stack": ["content_qa", "commercial_qa"]
    }
  },
  "tools": {
    "arabic_readability_osman": {
      "id": "arabic_readability_osman",
      "category": "language_qa",
      "purpose": "Arabic text readability/comprehensibility metric (OSMAN/Osman). Proxy signal for Arabic naturalness (the #1 Arabic-user pain in MARKET_VALIDATION_PROMPT_PACK_REPORT).",
      "classification": "OBSERVED",
      "evidence_kind": "measured_score",
      "license": "MIT (textstat PyPI project; OSMAN metric per LREC 2016)",
      "provider": "pypi:textstat",
      "module": "quality_toolchain.adapters.textstat_osman",
      "function": "check_readability",
      "windows_compatible": true,
      "requires_binary": null,
      "install_hint": "python -m pip install --quiet textstat",
      "enabled": true,
      "timeout_seconds": 30,
      "fallback": "not_available",
      "version_detection": "import textstat; textstat.__version__"
    },
    "distinctiveness_overlap": {
      "id": "distinctiveness_overlap",
      "category": "originality_qa",
      "purpose": "Measured distinctiveness of a product's text vs. reference/free-alternative texts (Jaccard-style overlap + longest-common-substring proxy). Directly targets Gap 2 (vs. free documented packs) using only Python stdlib; deterministic and zero-dependency.",
      "classification": "DERIVED",
      "evidence_kind": "computed_metric",
      "license": "internal (stdlib difflib, no third-party dependency)",
      "provider": "stdlib",
      "module": "quality_toolchain.adapters.distinctiveness",
      "function": "check_distinctiveness",
      "windows_compatible": true,
      "requires_binary": null,
      "install_hint": "none (pure stdlib)",
"enabled": true,
        "timeout_seconds": 30,
        "fallback": "not_available",
        "version_detection": "python stdlib_VERSION_MARKER",
        "performance": {
          "_note": "FOUNDER-APPROVED 2026-09-02: LCS is NOT in the mandatory production critical path. It is an expensive structural guard (observed 63.65s on a 20,951-char product vs ~0.01s corpus median). Bounded by max_lcs_chars; runs only when candidate+reference fit the bound; strict lcs_timeout_s fail-safe. An unavailable/timed-out LCS NEVER becomes a QUALITY PASS (verdict becomes advisory REVIEW, fail-closed).",
          "enable_lcs": true,
          "max_lcs_chars": 20000,
          "lcs_timeout_s": 5,
          "normalize": true
        }
    },
