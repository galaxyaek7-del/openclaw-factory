  "id": "TN04telegramNotifyX",
  "name": "04_Telegram_Notify",
  "description": "Receives factory_loop.js's notifyGoldenHunterAccepted() POST the moment a real opportunity clears profit_oracle's acceptance gate (ADR-065 Step 3(a)), and forwards it to Telegram as a real message via a plain HTTP Request to Telegram's Bot API (not an n8n Telegram credential — this instance's REST API/UI was not reachable this session to create one; TELEGRAM_BOT_TOKEN/OPENCLAW_TELEGRAM_CHAT_ID are read from the n8n process's own environment via $env, never embedded in this file). Imported via CLI while n8n was offline (ADR-072) — same safe pattern as ADR-045.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "path": "golden-hunter-notify",
        "httpMethod": "POST",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-560, 0],
      "id": "b1c2d3e4-0001-4a11-9e11-000000000001",
      "name": "Webhook",
      "webhookId": "b1c2d3e4-0001-4a11-9e11-000000000099"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1c2d3e4-0002-4a11-9e11-000000000002",
              "name": "message",
              "value": "={{ \"\\uD83C\\uDFC6 Golden Hunter accepted a new opportunity\\n\\nNiche: \" + $json.body.niche + \"\\nOpportunity Score: \" + $json.body.opportunity_score + \"/100\\n\" + $json.body.reason }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-384, 0],
      "id": "b1c2d3e4-0003-4a11-9e11-000000000003",
      "name": "Build Telegram Message"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage?chat_id={{ $env.OPENCLAW_TELEGRAM_CHAT_ID }}&text={{ encodeURIComponent($json.message) }}",
        "options": {}
